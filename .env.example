# App
APP_PUBLIC_URL=http://localhost:3000
NODE_ENV=development
RISKRADAR_DATA_FILE=.riskradar/riskradar.db.json
RISKRADAR_LOG_DIR=.riskradar/logs
RISKRADAR_WORKSPACE_DIR=.riskradar/workspaces

# Durable persistence (opt-in; default = local JSON file).
# Start the containers with: docker compose up -d
# Then set RISKRADAR_PERSIST_POSTGRES=true to mirror state into Postgres (durable
# system of record); the local file remains the working copy. Verify: pnpm verify:postgres
RISKRADAR_PERSIST_POSTGRES=false
DATABASE_URL=postgresql://riskradar:riskradar@localhost:5432/riskradar

# Durable queue/scheduler (opt-in; default = local inline mode).
# Set RISKRADAR_QUEUE_MODE=redis to use the Redis/BullMQ durable queue + watch
# schedule (survives restarts). Verify: pnpm verify:queue
REDIS_URL=redis://localhost:6379
RISKRADAR_QUEUE_MODE=local

# GitHub
GITHUB_TOKEN=
RISKRADAR_TEST_REPO=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# OpenAI / Codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
CODEX_BIN=codex
CODEX_ENABLED=true
CODEX_SANDBOX_MODE=workspace-write
# Default Codex CLI timeout. verify:codex-live defaults to 300000 when this is
# unset; an explicit value here wins for both normal and live runs.
CODEX_TIMEOUT_MS=300000

# Vercel AI SDK / AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5
VERCEL_OIDC_TOKEN=

# BYO model provider layer
# codex = workspace editor (only model allowed to edit the repo)
# openrouter | openai-compatible | ollama = strict-JSON plan advisors (RiskRadar applies the change)
# deterministic = no model; RiskRadar updates the dependency to the OSV-known fixed version
RISKRADAR_AGENT_PROVIDER=codex
RISKRADAR_AGENT_MODEL=
RISKRADAR_LLM_BASE_URL=
RISKRADAR_LLM_API_KEY=
RISKRADAR_LLM_TIMEOUT_MS=120000
# Reserved safety switch; even when true RiskRadar still applies the change itself.
RISKRADAR_LLM_ALLOW_DIRECT_PATCH=false

# Provider failover ladder (safe defaults; ask = consent before lower-trust)
RISKRADAR_PROVIDER_FAILOVER_MODE=ask
RISKRADAR_PROVIDER_CHAIN=codex,openrouter,anthropic,grok,openai-compatible,ollama,deterministic
# Per-provider keys/base URLs (optional; fall back to RISKRADAR_LLM_* where noted)
RISKRADAR_GROK_API_KEY=
RISKRADAR_GROK_BASE_URL=https://api.x.ai/v1
RISKRADAR_ANTHROPIC_API_KEY=
RISKRADAR_ANTHROPIC_BASE_URL=https://api.anthropic.com
RISKRADAR_ANTHROPIC_VERSION=2023-06-01
RISKRADAR_ALLOW_CLOUD_MODEL_FAILOVER=true
RISKRADAR_ALLOW_LOCAL_MODEL_FAILOVER=false
RISKRADAR_REQUIRE_CONSENT_FOR_LOWER_TRUST_PROVIDER=true
RISKRADAR_FAST_FAILOVER=true
RISKRADAR_PROVIDER_CHAIN_MAX_ATTEMPTS=3
RISKRADAR_PROVIDER_READINESS_TIMEOUT_MS=3000
RISKRADAR_PROVIDER_ATTEMPT_TIMEOUT_MS=30000
RISKRADAR_PROVIDER_READINESS_CACHE_TTL_MS=600000

# Continuous watch mode (disabled by default; never auto-patches)
RISKRADAR_WATCH_ENABLED=false
RISKRADAR_WATCH_INTERVAL_MINUTES=60
RISKRADAR_WATCH_TELEGRAM_ALERTS=true
RISKRADAR_QUIET_HOURS=

# Scanner orchestration (external tools optional; tool_missing until installed)
RISKRADAR_SCANNER_OSV_ENABLED=true
RISKRADAR_SCANNER_OSV_SCANNER_PATH=osv-scanner
RISKRADAR_SCANNER_GITLEAKS_ENABLED=true
RISKRADAR_SCANNER_GITLEAKS_PATH=gitleaks
RISKRADAR_SCANNER_SEMGREP_ENABLED=true
RISKRADAR_SCANNER_SEMGREP_PATH=semgrep
RISKRADAR_SCANNER_TRIVY_ENABLED=true
RISKRADAR_SCANNER_TRIVY_PATH=trivy
RISKRADAR_SCANNER_SYFT_ENABLED=false
RISKRADAR_SCANNER_SYFT_PATH=syft
RISKRADAR_SCANNER_TIMEOUT_MS=120000
RISKRADAR_MALICIOUS_PACKAGES_DIR=
RISKRADAR_LICENSE_POLICY_PATH=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
APPROVAL_SIGNING_SECRET=
APPROVAL_HMAC_SECRET=

# Provenance attestation (optional). HMAC key used to sign the remediation
# attestation (from→to, validation, changed files) embedded in the PR body +
# audit receipt. Falls back to APPROVAL_HMAC_SECRET. Unset = honest unsigned
# statement (never a fake signature). Verify with verifyAttestation().
RISKRADAR_ATTESTATION_SECRET=

# Local folder scanning
RISKRADAR_LOCAL_ROOTS=

# Vulnerability intelligence
OSV_API_URL=https://api.osv.dev/v1/querybatch
NVD_API_URL=
NVD_API_KEY=
GHSA_API_URL=
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
OPENSSF_MALICIOUS_PACKAGES_DIR=

# Vercel optional
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# OpenClaw optional
OPENCLAW_BIN=openclaw
OPENCLAW_ENABLED=false

# MCP
RISKRADAR_MCP_ENABLED=true

# Test/advanced (normally unset)
RISKRADAR_DISABLE_OSV_SCANNER=
RISKRADAR_SMOKE_BASE_URL=

# SBOM tools
SYFT_BIN=syft
CYCLONEDX_NPM_BIN=cyclonedx-npm

# Dashboard auth (optional). When set, dashboard + API require this token
# (cookie rr_token / x-riskradar-token header / Authorization: Bearer / ?token=).
# Unset = open (local dev). The Telegram webhook is exempt (own secret).
RISKRADAR_DASHBOARD_TOKEN=

# Container image scan (optional, opt-in)
RISKRADAR_CONTAINER_IMAGE=

# Signed plugin registry (optional). When set, plugins must be in a signed
# registry with a valid HMAC signature to load.
RISKRADAR_PLUGIN_SIGNING_SECRET=

# Secret-manager file (optional). JSON of {KEY: value} (Docker/K8s secret mount
# or Vault file sink). Fills only unset keys; explicit env/.env win.
RISKRADAR_SECRETS_FILE=

# Deployment preview verification (optional)
RISKRADAR_DEPLOYMENT_URL=
RISKRADAR_DEPLOYMENT_TIMEOUT_MS=8000

# Safety
RISKRADAR_ALLOW_AUTO_MERGE=false
RISKRADAR_ALLOW_PROD_DEPLOY=false
RISKRADAR_APPLY_LOCAL_PATCH_ON_APPROVAL=false
RISKRADAR_WORKER_MODE=local
RISKRADAR_RETAIN_WORKSPACES=false
RISKRADAR_COMMAND_TIMEOUT_MS=120000
# When false (default), npm install lifecycle scripts are ignored during validation.
RISKRADAR_ALLOW_VALIDATION_SCRIPTS=false
